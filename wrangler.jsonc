{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toas-monitor",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "compatibility_date": "2026-10-19",
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "TOAS_STATE",
      "id": "f5ffeef815d54e69a021a2545a859913"
    }
  ]
}
